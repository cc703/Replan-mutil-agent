{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "changes"
  ],
  "properties": {
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "discriminator": {
          "mapping": {
            "DEADLINE": "#/$defs/Deadline",
            "DEVICE_OUTAGE": "#/$defs/Outage",
            "TASK_OVERRUN": "#/$defs/Overrun",
            "URGENT_TASK_INSERT": "#/$defs/Urgent"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/Outage"
          },
          {
            "$ref": "#/$defs/Deadline"
          },
          {
            "$ref": "#/$defs/Urgent"
          },
          {
            "$ref": "#/$defs/Overrun"
          }
        ]
      }
    }
  },
  "$defs": {
    "Deadline": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "v001",
          "default": "v001",
          "title": "Version",
          "type": "string"
        },
        "strength": {
          "enum": [
            "HARD",
            "SOFT"
          ],
          "title": "Strength",
          "type": "string"
        },
        "kind": {
          "const": "DEADLINE",
          "title": "Kind",
          "type": "string"
        },
        "task": {
          "$ref": "#/$defs/EntityRef"
        },
        "deadline": {
          "format": "date-time",
          "title": "Deadline",
          "type": "string"
        },
        "level": {
          "enum": [
            "HARD",
            "NEGOTIABLE"
          ],
          "title": "Level",
          "type": "string"
        },
        "weight": {
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "strength",
        "kind",
        "task",
        "deadline",
        "level",
        "weight"
      ],
      "title": "Deadline",
      "type": "object"
    },
    "EntityRef": {
      "additionalProperties": false,
      "properties": {
        "original": {
          "minLength": 1,
          "title": "Original",
          "type": "string"
        },
        "resolved_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved Id"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "original",
        "confidence"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "Outage": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "v001",
          "default": "v001",
          "title": "Version",
          "type": "string"
        },
        "strength": {
          "enum": [
            "HARD",
            "SOFT"
          ],
          "title": "Strength",
          "type": "string"
        },
        "kind": {
          "const": "DEVICE_OUTAGE",
          "title": "Kind",
          "type": "string"
        },
        "device": {
          "$ref": "#/$defs/EntityRef"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "strength",
        "kind",
        "device",
        "start",
        "end"
      ],
      "title": "Outage",
      "type": "object"
    },
    "Overrun": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "v001",
          "default": "v001",
          "title": "Version",
          "type": "string"
        },
        "strength": {
          "enum": [
            "HARD",
            "SOFT"
          ],
          "title": "Strength",
          "type": "string"
        },
        "kind": {
          "const": "TASK_OVERRUN",
          "title": "Kind",
          "type": "string"
        },
        "task": {
          "$ref": "#/$defs/EntityRef"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "strength",
        "kind",
        "task",
        "end"
      ],
      "title": "Overrun",
      "type": "object"
    },
    "Precedence": {
      "additionalProperties": false,
      "properties": {
        "pred": {
          "title": "Pred",
          "type": "string"
        },
        "succ": {
          "title": "Succ",
          "type": "string"
        },
        "lag_min": {
          "default": 0,
          "minimum": 0,
          "title": "Lag Min",
          "type": "integer"
        },
        "lag_max": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lag Max"
        }
      },
      "required": [
        "pred",
        "succ"
      ],
      "title": "Precedence",
      "type": "object"
    },
    "Urgent": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "v001",
          "default": "v001",
          "title": "Version",
          "type": "string"
        },
        "strength": {
          "enum": [
            "HARD",
            "SOFT"
          ],
          "title": "Strength",
          "type": "string"
        },
        "kind": {
          "const": "URGENT_TASK_INSERT",
          "title": "Kind",
          "type": "string"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/UrgentTask"
          },
          "minItems": 1,
          "title": "Tasks",
          "type": "array"
        },
        "precedences": {
          "items": {
            "$ref": "#/$defs/Precedence"
          },
          "title": "Precedences",
          "type": "array"
        }
      },
      "required": [
        "strength",
        "kind",
        "tasks"
      ],
      "title": "Urgent",
      "type": "object"
    },
    "UrgentTask": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "experiment_id": {
          "minLength": 1,
          "title": "Experiment Id",
          "type": "string"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "duration_minutes": {
          "exclusiveMinimum": 0,
          "title": "Duration Minutes",
          "type": "integer"
        },
        "release": {
          "format": "date-time",
          "title": "Release",
          "type": "string"
        },
        "deadline": {
          "format": "date-time",
          "title": "Deadline",
          "type": "string"
        },
        "deadline_level": {
          "default": "NEGOTIABLE",
          "enum": [
            "HARD",
            "NEGOTIABLE"
          ],
          "title": "Deadline Level",
          "type": "string"
        },
        "weight": {
          "default": 1.0,
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "compatible_devices": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Compatible Devices",
          "type": "array"
        },
        "preemptible": {
          "default": false,
          "title": "Preemptible",
          "type": "boolean"
        },
        "demand": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Demand",
          "type": "integer"
        },
        "required_skills": {
          "items": {
            "type": "string"
          },
          "title": "Required Skills",
          "type": "array"
        },
        "requires_person": {
          "default": false,
          "title": "Requires Person",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "experiment_id",
        "type",
        "duration_minutes",
        "release",
        "deadline",
        "compatible_devices"
      ],
      "title": "UrgentTask",
      "type": "object"
    }
  }
}
